# Example only. Keep real values in a git-ignored .env or Render secret settings.
NODE_ENV=development
PORT=3000
FIREBASE_PROJECT_ID=roomcraft-ai-c4bf7
# Local: absolute path OUTSIDE the repository. Render: /etc/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/outside/repository/firebase-service-account.json
REPLICATE_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:7357,http://127.0.0.1:7357
# Leave disabled until staging, Firestore client-deny rules and billing are reviewed.
AI_ENABLED=false
AI_LEDGER_RULES_CONFIRMED=false
AI_USER_DAILY_LIMIT=10
AI_USER_MINUTE_LIMIT=3
AI_GLOBAL_DAILY_LIMIT=100
AI_GLOBAL_CONCURRENT_LIMIT=3
AI_DEDUP_SECONDS=60
AI_TIMEOUT_SECONDS=180
AI_HTTP_TIMEOUT_SECONDS=20
